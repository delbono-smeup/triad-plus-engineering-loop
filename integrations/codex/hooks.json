{
  "description": "Triad external verification dispatch only; requires Codex CLI 0.148.0 or newer and never changes card state.",
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^triad_developer$",
        "hooks": [
          {
            "type": "command",
            "command": "node <TRIAD_RUNTIME>/triad-verify.mjs --project <TRIAD_CONTROL_ROOT>",
            "async": true,
            "timeout": 900,
            "statusMessage": "Running Triad verification"
          }
        ]
      }
    ]
  }
}
