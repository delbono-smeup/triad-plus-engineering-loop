{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triad.engineering/schemas/evaluation-result.schema.json",
  "title": "Triad fresh evaluation result",
  "type": "object",
  "required": ["schema_version", "feature_id", "candidate_fingerprint", "quality_bar_id", "quality_bar_sha256", "verdict", "largest_gap", "critical_anomaly", "evidence_refs", "confidence", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "feature_id": { "type": "string", "minLength": 1 },
    "candidate_fingerprint": { "type": "string", "minLength": 1 },
    "quality_bar_id": { "type": "string", "minLength": 1 },
    "quality_bar_sha256": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["candidate_wins", "bar_wins", "indeterminate"] },
    "largest_gap": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["fingerprint", "category", "evidence", "why_it_matters", "bounded_repair"], "properties": { "fingerprint": { "type": "string" }, "category": { "type": "string" }, "evidence": { "type": "string" }, "why_it_matters": { "type": "string" }, "bounded_repair": { "type": "string" } } }
      ]
    },
    "critical_anomaly": { "type": ["string", "null"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "confidence": { "enum": ["high", "medium", "low"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "verdict": { "const": "bar_wins" } } }, "then": { "properties": { "largest_gap": { "type": "object" } } } }
  ]
}
